# Este arquivo é um exemplo. Copie para .env.local e configure seus valores.
# Nunca commite .env.local no repositório!

# ===== BACKEND =====
PORT=3001

# ===== FRONTEND =====
# Mapbox token (obrigatório)
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# URL do backend (em desenvolvimento local, deixe em branco para usar proxy)
VITE_BACKEND_URL=http://localhost:3001

# ===== SUPABASE (Opcional - para persistência futura) =====
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=sua_chave_anonima
